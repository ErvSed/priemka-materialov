PORT=8787
HOST=0.0.0.0

# Сгенерируйте: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MAIL_API_TOKEN=replace-with-at-least-24-random-characters

# Откуда разрешены запросы браузера
ALLOWED_ORIGINS=https://ervsed.github.io,http://127.0.0.1:8765,http://localhost:8080

# SMTP-сервер, через который уходят письма
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ПРИЁМКА <no-reply@example.com>"
SMTP_REPLY_TO=

# Где хранится зашифрованный снимок расписания
DATA_DIR=./data
SCHEDULER_TICK_MS=30000
